# ── Database type ─────────────────────────────────────────────────────────────
# Supported: postgresql, mysql, sqlite, mssql
DB_TYPE=postgresql

# ── Database credentials ─────────────────────────────────────────────────────
# Used by: postgresql, mysql, mssql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_database
DB_USER=my_user
DB_PASSWORD=my_password

# SQLite only — path to the .db file (ignored for other DB types)
# DB_PATH=./my_database.db

# SQL Server only — ODBC driver name (ignored for other DB types)
# DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ── Ollama settings ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Server settings ──────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio
LOG_LEVEL=INFO
